       " {'MedlineCitation': DictElement({'KeywordList': [ListElement([StringElement('Differential expression analysis', attributes={'MajorTopicYN': 'N'}), StringElement('False discovery rate', attributes={'MajorTopicYN': 'N'}), StringElement('False selection rate', attributes={'MajorTopicYN': 'N'}), StringElement('Variable selection', attributes={'MajorTopicYN': 'N'})], attributes={'Owner': 'NOTNLM'})], 'CitationSubset': [], 'GeneralNote': [], 'OtherID': [], 'InvestigatorList': [], 'OtherAbstract': [], 'SpaceFlightMission': [], 'PMID': StringElement('42212236', attributes={'Version': '1'}), 'DateRevised': {'Year': '2026', 'Month': '08', 'Day': '13'}, 'Article': DictElement({'ArticleDate': [DictElement({'Year': '2024', 'Month': '11', 'Day': '02'}, attributes={'DateType': 'Electronic'})], 'Language': ['eng'], 'ELocationID': [StringElement('10.1007/s13253-024-00665-3', attributes={'EIdType': 'doi', 'ValidYN': 'Y'})], 'Journal': {'ISSN': StringElement('1085-7117', attributes={'IssnType': 'Print'}), 'JournalIssue': DictElement({'Volume': '31', 'Issue': '2', 'PubDate': {'Year': '2026'}}, attributes={'CitedMedium': 'Print'}), 'Title': 'Journal of agricultural, biological, and environmental statistics', 'ISOAbbreviation': 'J Agric Biol Environ Stat'}, 'ArticleTitle': 'Identifying Relevant Covariates in RNA-seq Analysis by Pseudo-Variable Augmentation.', 'Pagination': {'StartPage': '367', 'EndPage': '386', 'MedlinePgn': '367-386'}, 'Abstract': {'AbstractText': [StringElement('RNA-sequencing (RNA-seq) technology allows for the identification of differentially expressed genes, which are genes whose mean transcript abundance levels vary across conditions. In practice, RNA-seq datasets often include covariates that are of primary interest in addition to a set of covariates that are subject to selection. Some of these covariates may be relevant to gene expression levels, while others may be irrelevant. Ignoring relevant covariates or attempting to adjust for the effect of irrelevant covariates can compromise the identification of differentially expressed genes. To address this issue, we propose a variable selection method that uses pseudo-variables to control the expected proportion of selected covariates that are irrelevant. Our method accurately selects relevant covariates while keeping the false selection rate below a specified level. We demonstrate that our method outperforms existing methods for detecting differentially expressed genes when working with available covariates. Our method is implemented in FSRAnalysisBS function of the R package csrnaseq, which is available at www.github.com/ntyet/csrnaseq. The analysis and simulation are available at www.github.com/ntyet/csrnaseq/tree/main/analysis.', attributes={'Label': 'UNLABELLED'}), StringElement('The online version contains supplementary material available at 10.1007/s13253-024-00665-3.', attributes={'Label': 'SUPPLEMENTARY INFORMATION', 'NlmCategory': 'UNASSIGNED'})], 'CopyrightInformation': '© The Author(s) 2024.'}, 'AuthorList': ListElement([DictElement({'Identifier': [StringElement('0000-0003-4881-3476', attributes={'Source': 'ORCID'})], 'AffiliationInfo': [{'Identifier': [StringElement('https://ror.org/04zjtrb98', attributes={'Source': 'ROR'}), StringElement('grid.261368.8', attributes={'Source': 'GRID'}), StringElement('0000 0001 2164 3177', attributes={'Source': 'ISNI'})], 'Affiliation': 'Department of Mathematics and Statistics, Old Dominion University, Norfolk, VA 23529 USA.'}], 'LastName': 'Nguyen', 'ForeName': 'Yet', 'Initials': 'Y'}, attributes={'ValidYN': 'Y'}), DictElement({'Identifier': [], 'AffiliationInfo': [{'Identifier': [StringElement('https://ror.org/04rswrd78', attributes={'Source': 'ROR'}), StringElement('grid.34421.30', attributes={'Source': 'GRID'}), StringElement('0000 0004 1936 7312', attributes={'Source': 'ISNI'})], 'Affiliation': 'Department of Statistics, Iowa State University, Ames, IA 50011 USA.'}], 'LastName': 'Nettleton', 'ForeName': 'Dan', 'Initi