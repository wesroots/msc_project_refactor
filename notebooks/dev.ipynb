       " {'MedlineCitation': DictElement({'KeywordList': [ListElement([StringElement('Coronary artery disease', attributes={'MajorTopicYN': 'N'}), StringElement('Familial hypercholesterolemia', attributes={'MajorTopicYN': 'N'}), StringElement('Indians', attributes={'MajorTopicYN': 'N'}), StringElement('LDLR', attributes={'MajorTopicYN': 'N'}), StringElement('Non-mendelian inheritance', attributes={'MajorTopicYN': 'N'})], attributes={'Owner': 'NOTNLM'})], 'CitationSubset': [], 'GeneralNote': [], 'OtherID': [], 'InvestigatorList': [], 'OtherAbstract': [], 'SpaceFlightMission': [], 'PMID': StringElement('42500340', attributes={'Version': '1'}), 'DateCompleted': {'Year': '2026', 'Month': '07', 'Day': '25'}, 'DateRevised': {'Year': '2026', 'Month': '07', 'Day': '26'}, 'Article': DictElement({'ArticleDate': [DictElement({'Year': '2024', 'Month': '07', 'Day': '25'}, attributes={'DateType': 'Electronic'})], 'Language': ['eng'], 'ELocationID': [StringElement('10.1007/s12291-024-01252-6', attributes={'EIdType': 'doi', 'ValidYN': 'Y'})], 'Journal': {'ISSN': StringElement('0970-1915', attributes={'IssnType': 'Print'}), 'JournalIssue': DictElement({'Volume': '41', 'Issue': '4', 'PubDate': {'Year': '2026', 'Month': 'Aug'}}, attributes={'CitedMedium': 'Print'}), 'Title': 'Indian journal of clinical biochemistry : IJCB', 'ISOAbbreviation': 'Indian J Clin Biochem'}, 'ArticleTitle': 'Likelihood of a Novel Pathogenic <i>LDLR</i> Mutant Allele Inherited Preferentially within an Indian Family with Familial Hypercholesterolemia.', 'Pagination': {'StartPage': '639', 'EndPage': '643', 'MedlinePgn': '639-643'}, 'Abstract': {'AbstractText': [StringElement('Familial hypercholesterolemia (FH) is an autosomal dominant disorder characterized by elevated levels of low-density lipoprotein cholesterol (LDL-C), primarily caused by mutations in the LDL receptor (<i>LDLR</i>) gene. Screening of family members is crucial for early detection and management. Here, we report on an Indian family with FH harboring a novel pathogenic nonsense mutation in the <i>LDLR</i> gene, which exhibits a pattern suggestive of preferential transmission. Whole exome sequencing of a member with definite FH from consanguineous parents, identified by Dutch Lipid Clinic Network Criteria, revealed a novel pathogenic nonsense mutation (c.743_744delinsAA) in exon 5 of the <i>LDLR</i> gene. This mutation was predicted to be deleterious by in silico online tools such as SIFT and MutationTaster. Sanger Sequencing confirmed the presence of this mutation in all available affected family members. Interestingly, despite an expected 50% chance of inheriting the wild-type allele (CG), all offspring consistently inherited the mutant <i>LDLR</i> allele (AA). This observation suggests a non-random pattern of preferential allele transmission, potentially influenced by genetically biased fertilization or genetic factors beyond typical Mendelian inheritance patterns. This study represents the first report of this novel <i>LDLR</i> mutation in an Indian family with FH.', attributes={'Label': 'UNLABELLED'}), StringElement('The online version contains supplementary material available at 10.1007/s12291-024-01252-6.', attributes={'Label': 'SUPPLEMENTARY INFORMATION', 'NlmCategory': 'UNASSIGNED'})], 'CopyrightInformation': '© The Author(s), under exclusive licence to Association of Clinical Biochemists of India 2024.'}, 'AuthorList': ListElement([DictElement({'Identifier': [], 'AffiliationInfo': [{'Identifier': [StringElement('https://ror.org/00a6fbp85', attributes={'Source': 'ROR'}), StringElement('grid.417189.2', attributes={'Source': 'GRID'}), StringElement('0000 0004 1791 5899', attributes={'Source': 'ISNI'})], 'Affiliation': 'Research Laboratories, P. D Hinduja Hospital and Medical Research Centre, Mumbai, Maharashtra 400016 India.'}], 'LastName': 'Reddy', 'ForeName': 'Lakshmi Lavanya', 'Initials': 'LL'}, attributes={'ValidYN': 'Y'}), DictElement({'Identifier': [StringElement('0000-0003-1703-5990', attrib